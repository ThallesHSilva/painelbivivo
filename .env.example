# Credenciais do administrador. Configure estes valores na VPS.
AUTH_EMAIL=seu-email@empresa.com.br
# Preencha para manter a senha legível no seu .env. Esse valor tem prioridade sobre o hash.
AUTH_PASSWORD=
# Hash opcional, usado quando AUTH_PASSWORD estiver vazio.
AUTH_PASSWORD_HASH=pbkdf2-sha256$210000$salt$hash

# Use uma chave aleatória com pelo menos 32 caracteres.
# Exemplo para gerar: openssl rand -base64 48
AUTH_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# URL pública usada nos links de confirmação e na validação de requisições.
APP_ORIGIN=https://painelbi.inteligenciavivo.com.br

# Banco persistente local da VPS. Monte um volume permanente neste diretório.
DATABASE_PATH=/var/lib/mapa-parque/mapa-parque.sqlite

# Arquivos recebidos e snapshots usados pelos processadores.
UPLOAD_PATH=/var/lib/mapa-parque/uploads

# Porta interna da aplicação na VPS.
PORT=8000

# Envio de confirmação pelo Gmail. Use uma senha de app do Google de 16 caracteres.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_AUTH=true
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=senha-de-app-do-google
MAIL_FROM="Painel executivo <seu-email@gmail.com>"

# Para o relay do consulta-a7, use SMTP_HOST=smtp-relay.gmail.com,
# SMTP_PORT=587, SMTP_AUTH=auto e SMTP_FROM com o remetente autorizado.
# O relay autentica a VPS pelo IP configurado no Google Workspace.
